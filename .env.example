# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — used by server-side API routes that need to bypass RLS
# (e.g. /api/apply inserts the application row as the service client).
# Keep this secret. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack
PAYSTACK_SECRET_KEY=sk_live_or_test_your_key
# Optional: timeout in ms for Paystack verify calls (defaults to 8000)
PAYSTACK_TIMEOUT_MS=8000

# Resend (email)
RESEND_API_KEY=re_your_resend_key
RESEND_SENDER_EMAIL=onboarding@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Admin alerts — shared secret sent as the `x-admin-alert-secret` request
# header by internal callers (e.g. /api/webhooks/paystack, the exchange rate
# fallback chain in /api/paystack/initialize) to authenticate against
# /api/admin/alerts. Generate a strong random string (e.g. `openssl rand -hex 32`)
# and use the SAME value here as you set in Vercel project env vars.
ADMIN_ALERT_SECRET=replace_with_a_strong_random_secret

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# App
# Use http://localhost:3000 for local development
# Set this to the canonical URL for the deployed SurveyConnectHub app.
NEXT_PUBLIC_APP_URL=https://www.surveyconnecthub.com
# Optional comma-separated additional approved frontend origins.
NEXT_PUBLIC_APP_URLS=https://survey-connect-hub.vercel.app

# Cloudflare Turnstile bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFRsmxjU-U_dZObs
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
